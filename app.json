{
  "expo": {
    "name": "PassSaver",
    "slug": "PassSaver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/PassSaver_logo.jpeg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/PassSaver_logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#0a1a14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/PassSaver_logo.jpeg",
        "backgroundColor": "#0a1a14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.push4ck.PassSaver"
    },
    "web": {
      "favicon": "./assets/PassSaver_logo.jpeg"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "347e6bc9-366b-4b8a-8ced-30f6ca4d84d8"
      }
    }
  }
}